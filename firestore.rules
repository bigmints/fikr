rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {

      // Users can read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can write their own document.
      // The 'plan' field is exclusively written by fikr.one Admin SDK — the Flutter
      // app never sends 'plan' in its writes (it only writes email, config, updatedAt).
      // We trust that at the application level; no rule complexity needed here.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Notes — full read/write for the owning user
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /insights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Usage is written only by fikr.one backend (metering); clients can read it.
      match /usage/{month} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;  // Only Admin SDK (fikr.one) writes usage
      }

      // MCP server configs
      match /mcp_servers/{serverId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // MCP Relay Queue
      match /mcp_queue/{queueId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subscription history — immutable audit trail written only by the
      // billing webhook (Admin SDK). Clients can read their own history.
      match /subscriptionHistory/{eventId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;  // Only Admin SDK (billing webhook) writes
      }

      // Private data (e.g., synced API keys) — only fikr.one backend (Admin SDK).
      match /private/{doc} {
        allow read, write: if false;
      }
    }
  }
}
